		# 	}
		# }
		
		using = bg_age_event_frame
		
		block "country_header_extra" {}
		blockoverride "abilities_widget" {}
	}

	##################################### MAIN CONTENT #####################################

	# ACTIONS
	blockoverride "situation_panel_main_content" {

		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'requirements_toggled' )]"
			}
			blockoverride "header_text" {
				text = "END_REQUIREMENTS"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "bottom_content" {
				TooltipRequirementsList = {
					textcontext = "[SituationView.GetActiveSituation.GetSituation.GetEndConditions]"
				}
			}
			blockoverride "visible_hint" {}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'requirements_toggled' ))]"
			}
		}
	}

	blockoverride "situation_panel_main_content_bottom" {
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 10
			margin = { 0 10 }
			
			# 所有参与势力：包含所有中国地区国家（不可折叠）
			situation_card_expandable = {
				blockoverride "header_button_onclick" {
					visible = no  # 隐藏折叠按钮
				}
				blockoverride "header_text" {
					text = "PARTICIPATING_COUNTRIES"
				}
				blockoverride "header_icon" {
					texture = "gfx/interface/icons/flat_icons/war_view/war_participants.dds"
				}
				blockoverride "bottom_content" {
					scrollarea = {
						layoutpolicy_horizontal = expanding
						maximumsize = { -1 400 }
						scrollbarpolicy_horizontal = always_off
						autoresizescrollarea = yes
						
						scrollbar_vertical = {
							using = Scrollbar_Vertical
						}
						
						scrollwidget = {
							dynamicgridbox = {
								# 使用 GetGlobalList 访问全局变量列表
								datamodel = "[GetGlobalList('china_countries_list')]"
								layoutpolicy_horizontal = expanding
								spacing = 5
								
								item = {
									widget = {
										size = { 480 40 }
										
										using = bg_paper_card
										using = bg_cabinet_card_frame
										
										# 鼠标悬停时在地图上高亮国家
										onmousehierarchyenter = "[Scope.GetCountry.HighlightOnMap(PdxGuiWidget.AccessSelf)]"
										
										hbox = {
											layoutpolicy_horizontal = expanding
											margin = { 8 0 }
											spacing = 10
											
											# 国旗
											widget = {
												size = { 42 28 }
												allow_outside = yes
												country_flag_small = {
													datacontext = "[Scope.GetCountry]"
													size = { 42 29 }
												}
											}
											
											# 国家名称
											text_single = {
												datacontext = "[Scope.GetCountry]"
												layoutpolicy_horizontal = expanding
												size = { -1 20 }
												align = left|nobaseline
												text = "[Country.GetNameWithNoTooltip]"
											}
											
											# 陆军军力（包含征召兵）
											hbox = {
												spacing = 5
												margin_right = 5
												
												text_single = {
													datacontext = "[Scope.GetCountry]"
													size = { 60 20 }
													align = right|nobaseline
													autoresize = no
													text = "[Country.GetTotalArmyStrengthAndPotentialLevies]"
												}
												
												icon = {
													size = { 25 25 }
													texture = "gfx/interface/icons/unit_category/total_strength.dds"
													glow = {
														name = "drop_shadow"
														glow_radius = 3
														color = {0.0 0.0 0.0 1.0}
														alpha = 0.6
													}
												}
											}
											
											divider_flavor_01 = {size = { 12 -1 }}
											
											# 控制人口
											hbox = {
												spacing = 5
												margin_right = 5
												
												text_single = {
													datacontext = "[Scope.GetCountry]"
													size = { 60 20 }
													align = right|nobaseline
													autoresize = no
													text = "[Country.GetTotalPopulation]"
												}
												
												icon = {
													size = { 25 25 }
													texture = "gfx/interface/icons/location_icons/population.dds"
													glow = {
														name = "drop_shadow"
														glow_radius = 3
														color = {0.0 0.0 0.0 1.0}
														alpha = 0.6
													}
												}
											}
											
											divider_flavor_01 = {size = { 12 -1 }}
											
											# 海军军力
											hbox = {
												spacing = 5
												margin_right = 10
												
												text_single = {
													datacontext = "[Scope.GetCountry]"
													size = { 40 20 }
													align = right|nobaseline
													autoresize = no
													text = "[Country.GetTotalShips]"
												}
												
												icon = {
													size = { 25 25 }
													texture = "gfx/interface/icons/flat_icons/war_view/navy_unit.dds"
													glow = {
														name = "drop_shadow"
														glow_radius = 3
														color = {0.0 0.0 0.0 1.0}
														alpha = 0.6
													}
												}
											}
										}
									}
									datacontext = "[Scope.GetCountry]"
									visible = "[Country.Exists]"
								}
							}
						}
					}
				}
				blockoverride "visible_hint" {}
				blockoverride "bottom_content_onclick" {
					visible = yes  # 内容始终可见
				}
				blockoverride "icon_replace_visible_yes" {
					visible = no  # 隐藏展开图标
				}
				blockoverride "icon_replace_visible_not" {
					visible = no  # 隐藏折叠图标
				}
			}
		}
	}
}

