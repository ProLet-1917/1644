situation_panel = {

	blockoverride "situation_panel_image" {
		# 基于 two_countries_header_template 的三国家header：顺、明、清
		layoutpolicy_horizontal = expanding
		size = { -1 205 }
		
		blockoverride "country_header_names_visible" { visible = no }
		
		# 背景图
		block "three_countries_header_image" {
			background = {
				texture = "gfx/interface/illustrations/situation/red_turban_rebellions.dds"
				texture_density = 2
				spriteType = stretched
				spriteborder = { 0 0 }
			}
		}
		
		# 渐变遮罩
		background = {
			using = color_dark_blue_texture
			alpha = 1
			margin_top = -50
			modify_texture = {
				using = bg_fade_vertical_up_mask_texture
				blend_mode = alphamultiply
				alpha = 1
			}
		}
		
		# 大顺 (CSH) - 左侧
		container = {
			block "FirstCountryVisible" {
				visible = "[And(GetCountry('CSH').Exists, GetCountry('CSH').GetGovernment.HasRulerOrRegent)]"
			}
			block "first_character_portrait_anchor" {
				parentanchor = bottom|left
			}
			container = {
				block "FirstCountryContext" {
					datacontext = "[GetCountry('CSH')]"
				}
				
				visible = "[And(GetCountry('CSH').Exists, GetCountry('CSH').GetGovernment.HasRulerOrRegent)]"
				
				block "first_character_portrait_anchor" {
					parentanchor = bottom|left
				}
				
				block "first_country_character_frame" {
					character_frame_medium_with_labels = {
						block "character_right_visible" {
							visible = yes
						}
						parentanchor = bottom|left
						size = { 180 200 }
						blockoverride "portrait_datacontext" {
							datacontext = "[GetCountry('CSH').GetGovernment.GetRulerOrRegent]"
						}
						blockoverride "character_religion_visibility" {
							visible = no
						}
					}
				}
			}
		}
		
		# 大明 (MNG) - 中间
		container = {
			block "SecondCountryVisible" {
				visible = "[And(GetCountry('MNG').Exists, GetCountry('MNG').GetGovernment.HasRulerOrRegent)]"
			}
			block "second_character_portrait_anchor" {
				parentanchor = bottom|hcenter
			}
			container = {
				block "SecondCountryContext" {
					datacontext = "[GetCountry('MNG')]"
				}
				
				visible = "[And(GetCountry('MNG').Exists, GetCountry('MNG').GetGovernment.HasRulerOrRegent)]"
				
				block "second_character_portrait_anchor" {
					parentanchor = bottom|hcenter
				}
				
				block "second_country_character_frame" {
					character_frame_medium_with_labels = {
						block "character_right_visible" {
							visible = yes
						}
						parentanchor = bottom|hcenter
						size = { 180 200 }
						blockoverride "portrait_datacontext" {
							datacontext = "[GetCountry('MNG').GetGovernment.GetRulerOrRegent]"
						}
						blockoverride "character_religion_visibility" {
							visible = no
						}
					}
				}
			}
		}
		
		# 大清 (QNG) - 右侧
		container = {
			block "ThirdCountryVisible" {
				visible = "[And(GetCountry('QNG').Exists, GetCountry('QNG').GetGovernment.HasRulerOrRegent)]"
			}
			block "third_character_portrait_anchor" {
				parentanchor = bottom|right
			}
			container = {
				block "ThirdCountryContext" {
					datacontext = "[GetCountry('QNG')]"
				}
				
				visible = "[And(GetCountry('QNG').Exists, GetCountry('QNG').GetGovernment.HasRulerOrRegent)]"
				
				block "third_character_portrait_anchor" {
					parentanchor = bottom|right
				}
				
				block "third_country_character_frame" {
					character_frame_medium_with_labels = {
						block "character_right_visible" {
							visible = yes
						}
						parentanchor = bottom|right
						size = { 180 200 }
						blockoverride "portrait_datacontext" {
							datacontext = "[GetCountry('QNG').GetGovernment.GetRulerOrRegent]"
						}
						blockoverride "character_religion_visibility" {
							visible = no
						}
					}
				}
			}
		}
		
		# # 大顺名称和徽章
