		# 	}
		# }
		
		# # 大明名称和徽章
		# hbox = {
		# 	layoutpolicy_horizontal = expanding
		# 	layoutpolicy_vertical = expanding
			
		# 	block "SecondCountryVisible" {
		# 		visible = "[And(GetCountry('MNG').Exists, GetCountry('MNG').GetGovernment.HasRulerOrRegent)]"
		# 	}
		# 	hbox = {
		# 		using = layoutpolicy_expanding
		# 		block "SecondCountryContext" {
		# 			datacontext = "[GetCountry('MNG')]"
		# 		}
		# 		datacontext = "[GetCountry('MNG').GetGovernment]"
		# 		country_government_character = {
		# 			block "SecondCountryContext" {
		# 				datacontext = "[GetCountry('MNG')]"
		# 			}
		# 			blockoverride "character_name_maximumsize" {
		# 				maximumsize = { 160 -1 }
		# 			}
		# 			blockoverride "character_name_text" {
		# 				raw_text = "[Character.GetShortNameWithNoTooltip]"
		# 			}
		# 		}
		# 		blockoverride "bg_name_banner_flip" {}
		# 		blockoverride "bg_name_banner_margin" {
		# 			margin_left = 0
		# 			margin_right = 0
		# 			margin_top = 2
		# 			margin_bottom = 7
		# 		}
		# 	}
		# }
		
		# # 大清名称和徽章
		# hbox = {
		# 	layoutpolicy_horizontal = expanding
		# 	layoutpolicy_vertical = expanding
			
		# 	block "ThirdCountryVisible" {
		# 		visible = "[And(GetCountry('QNG').Exists, GetCountry('QNG').GetGovernment.HasRulerOrRegent)]"
		# 	}
		# 	hbox = {
		# 		using = layoutpolicy_expanding
		# 		block "ThirdCountryContext" {
		# 			datacontext = "[GetCountry('QNG')]"
		# 		}
		# 		datacontext = "[GetCountry('QNG').GetGovernment]"
		# 		country_government_character = {
		# 			block "ThirdCountryContext" {
		# 				datacontext = "[GetCountry('QNG')]"
		# 			}
		# 			blockoverride "country_header_orientation" {
		# 				righttoleft = yes
