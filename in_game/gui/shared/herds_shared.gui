template herds_regular {
    tooltipwidget = {
        using = herds_tooltip
    }
    text = "HERDS_TT"
    default_format = "#E"
}

template herds_tooltip {
    ConceptTooltipType = {
        resizeparent = no

        blockoverride "tooltip_title" {

            ConceptTooltipHeader = {
                blockoverride "title_icon" {
                    icon = {
                        using = tooltip_title_icon_size
                        texture = "gfx/interface/icons/flat_icons/tabicons/herds_flat_icon.dds"
                    }
                }

                blockoverride "title_text" {
                    text = "HERDS_TT"
                }
            }

            TooltipLockProgress = {}
        }

        blockoverride "tooltip_content" {
            TooltipTextBlock = {
                blockoverride "text" {
                    text = "HERDS_DEC_TT"
                }
            }
        }
    }
}